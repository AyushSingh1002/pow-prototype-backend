// Prisma Schema Blueprint for PrintOnWeb Storefront Backend
// Target DB: PostgreSQL
// Purpose: Defines relational integrity, unique constraints, and indexes
// required when a persistent PostgreSQL database is brought into scope.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum FileStatus {
  PENDING
  UPLOADED
  SCANNED
  REJECTED
}

model Product {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  description String
  category    String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  options     PrintOption[]
  quotes      Quote[]

  @@index([category])
  @@map("products")
}

model PrintOption {
  id          String   @id @default(uuid())
  productId   String
  code        String
  name        String
  type        String   // size, stock, finish, sides, color
  choices     Json     // List of allowed choice values with display labels
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@index([productId])
  @@map("print_options")
}

model Quote {
  id                   String      @id @default(uuid()) @db.Uuid
  productId            String
  selectedOptions      Json        // Validated options map
  quantity             Int
  baseUnitPrice        Int         // Minor units (integer)
  optionAdjustments    Json        // Line items breakdown
  quantityBreakDiscount Int        // Minor units (integer)
  setupFee             Int         // Minor units (integer)
  total                Int         // Minor units (integer)
  currency             String
  pricingConfigVersion String
  isSample             Boolean     @default(true)
  taxIncluded          Boolean     @default(false)
  shippingIncluded     Boolean     @default(false)
  expiresAt            DateTime
  createdAt            DateTime    @default(now())
  product              Product     @relation(fields: [productId], references: [id])
  orders               Order[]
  files                File[]

  @@index([expiresAt])
  @@index([createdAt])
  @@map("quotes")
}

model Order {
  id             String               @id @default(uuid()) @db.Uuid
  quoteId        String               @db.Uuid
  customerId     String
  idempotencyKey String
  status         OrderStatus          @default(DRAFT)
  total          Int                  // Minor units (recomputed & confirmed)
  currency       String
  assignedStaffId String?             @db.Uuid
  claimedAt      DateTime?
  deliveryMethod String               @default("SHIP")
  deliveryDeadline DateTime?
  paymentLinkId String?               @unique @map("payment_link_id")
  paymentLinkUrl String?              @map("payment_link_url")
  paymentLinkExpiresAt DateTime?      @map("payment_link_expires_at")
  paymentLinkState String?            @map("payment_link_state")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  quote          Quote                @relation(fields: [quoteId], references: [id])
  assignedStaff  StaffAccount?         @relation("AssignedStaff", fields: [assignedStaffId], references: [userId])
  statusHistory  OrderStatusHistory[]
  files          File[]
  staffNotes     StaffOrderNote[]
  notifications  NotificationOutbox[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt])
  @@map("orders")
}

model StaffAccount {
  userId      String           @id @db.Uuid
  displayName String           @map("display_name")
  role        String
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  assignedOrders Order[]       @relation("AssignedStaff")
  notes       StaffOrderNote[]

  @@map("staff_accounts")
}

model StaffOrderNote {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid @map("order_id")
  staffUserId     String       @db.Uuid @map("staff_user_id")
  note            String
  customerVisible Boolean      @default(false) @map("customer_visible")
  createdAt       DateTime     @default(now()) @map("created_at")
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff           StaffAccount @relation(fields: [staffUserId], references: [userId])

  @@index([orderId, createdAt])
  @@map("staff_order_notes")
}

model NotificationOutbox {
  id                  String   @id @default(uuid()) @db.Uuid
  jobKey              String   @unique @map("job_key")
  orderId             String   @db.Uuid @map("order_id")
  eventType           String   @map("event_type")
  payload             Json
  status              String   @default("PENDING")
  attempts            Int      @default(0)
  maxAttempts         Int      @default(5) @map("max_attempts")
  lastError           String?  @map("last_error")
  nextAttemptAt       DateTime @default(now()) @map("next_attempt_at")
  processingStartedAt DateTime? @map("processing_started_at")
  createdAt           DateTime @default(now()) @map("created_at")
  deliveredAt         DateTime? @map("delivered_at")
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@map("notification_outbox")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  fromStatus OrderStatus?
  toStatus  OrderStatus
  reason    String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model File {
  id           String     @id @default(uuid()) @db.Uuid
  storageKey   String     @unique // Server-generated UUID, never exposed directly to clients
  originalName String     // Sanitized display name only
  mimeType     String
  sizeBytes    Int
  status       FileStatus @default(PENDING)
  quoteId      String?    @db.Uuid
  orderId      String?    @db.Uuid
  createdAt    DateTime   @default(now())
  quote        Quote?     @relation(fields: [quoteId], references: [id])
  order        Order?     @relation(fields: [orderId], references: [id])

  @@index([quoteId])
  @@index([orderId])
  @@map("files")
}

model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String   @unique // Provider event ID for idempotent processing
  eventType  String
  payload    Json
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

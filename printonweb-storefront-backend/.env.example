# Runtime Environment
NODE_ENV=development
ENABLE_DEMO_MODE=true
PORT=5000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_INTERNAL_URL=http://127.0.0.1:5000

# Pricing and Quote Configuration
PRICING_CONFIG_VERSION=sample-v1
QUOTE_TTL_MINUTES=30
MAX_BODY_BYTES=102400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Database (Only when persistence is configured; prototype uses in-memory service by default)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Object Storage (Only if uploads are enabled; prototype defaults to stubbed upload service)
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=your-region
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# Razorpay (required when ENABLE_DEMO_MODE=false)
# Staff-created links expire after 24 hours and are sent through the configured email outbox.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production provider configuration (all values must be real; placeholders fail validation).
SUPABASE_URL=
SUPABASE_ANON_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
STAFF_DASHBOARD_URL=https://staff.example.com
STAFF_NOTIFICATION_RETRY_MAX=5
STORAGE_ENDPOINT=
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
PREFLIGHT_SERVICE_URL=
PREFLIGHT_SERVICE_TOKEN=
MIN_PRINT_DPI=

# Production business and operations configuration.
PRODUCTION_PRICING_CONFIG=
PRODUCTION_CATALOGUE_CONFIG=
TAX_RULES_CONFIG=
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_TOKEN=
FULFILLMENT_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_TOKEN=
CONTACT_DATA_RETENTION_DAYS=
ARTWORK_RETENTION_DAYS=
PRIVACY_POLICY_URL=
LOG_SINK_URL=
MONITORING_URL=
BACKUP_RPO_HOURS=
BACKUP_RTO_HOURS=
